@page "/work"
@inject IJSRuntime JS

<div class="page-header">
    <div class="container">
        <div class="ph-eyebrow"><div class="ph-eyebrow-line"></div><span>Selected Work</span></div>
        <h1 class="ph-title">
            <span class="line"><span>Case</span></span>
            <span class="line"><span class="accent">Studies.</span></span>
        </h1>
        <p class="ph-sub">Real engagements. Real outcomes. Every project documented with Problem, Solution, and quantifiable Result — because that's what actually matters to your business.</p>
    </div>
</div>

<section class="work-section">
    <div class="container">
        <div class="section-label">
            <div class="section-label-line"></div>
            <span>Engagements</span>
            <div class="section-label-num">3 Case Studies</div>
        </div>
    </div>

    <div class="cases-list">
        <!-- CS 01 -->
        <div class="case-study reveal">
            <div class="cs-meta">
                <div class="cs-tag">Government · Education</div>
                <div class="cs-index">01</div>
                <div>
                    <div class="cs-stack-label">Tech Stack</div>
                    <div class="cs-tech">.NET Blazor</div>
                    <div class="cs-tech">WCAG 2.0</div>
                    <div class="cs-tech">Azure Static Apps</div>
                    <div class="cs-tech">CSS Grid</div>
                </div>
            </div>
            <div class="cs-content">
                <h3 class="cs-title">Transforming Legacy React Portals into Dynamic Blazor Solutions</h3>
                <div class="cs-sections">
                    <div>
                        <div class="cs-section-label">Challenge</div>
                        <p class="cs-section-text">A government education portal was suffering from high maintenance costs and rigid layouts that couldn't adapt to evolving client needs across multiple departments. The React codebase had become a liability.</p>
                    </div>
                    <div>
                        <div class="cs-section-label">Approach</div>
                        <p class="cs-section-text">Migrated the entire frontend to .NET Blazor, enabling dynamic layout composition and reducing maintenance by unifying the codebase to a single source of truth. Implemented full WCAG 2.0 accessibility compliance throughout.</p>
                    </div>
                    <div>
                        <div class="cs-section-label">Outcome</div>
                        <div class="cs-outcome-num">100<span>%</span></div>
                        <p class="cs-section-text">Elimination of duplicate code maintenance overhead. Fully WCAG 2.0 compliant and accessible, delivered on schedule and within zero additional infrastructure cost.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- CS 02 -->
        <div class="case-study reveal">
            <div class="cs-meta">
                <div class="cs-tag">PropTech · Netherlands</div>
                <div class="cs-index">02</div>
                <div>
                    <div class="cs-stack-label">Tech Stack</div>
                    <div class="cs-tech">.NET Core</div>
                    <div class="cs-tech">Biometric 2FA</div>
                    <div class="cs-tech">Azure Functions</div>
                    <div class="cs-tech">Digital Signatures</div>
                </div>
            </div>
            <div class="cs-content">
                <h3 class="cs-title">Reducing Check-In Times by 60% via Custom .NET Architecture</h3>
                <div class="cs-sections">
                    <div>
                        <div class="cs-section-label">Challenge</div>
                        <p class="cs-section-text">A manual rental management process in the Netherlands was creating operational bottlenecks, slowing tenant onboarding and increasing the administrative burden on property managers significantly.</p>
                    </div>
                    <div>
                        <div class="cs-section-label">Approach</div>
                        <p class="cs-section-text">Designed a full-stack .NET Core system with biometric 2FA, digital signatures, and a mobile-responsive booking interface to completely digitize the rental onboarding workflow end-to-end.</p>
                    </div>
                    <div>
                        <div class="cs-section-label">Outcome</div>
                        <div class="cs-outcome-num">60<span>%</span></div>
                        <p class="cs-section-text">Reduction in check-in processing time. Secure, auditable digital documentation replaced all paper-based processes. Bookings convert faster with the mobile-responsive interface.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- CS 03 -->
        <div class="case-study reveal">
            <div class="cs-meta">
                <div class="cs-tag">FinTech · Greenfield</div>
                <div class="cs-index">03</div>
                <div>
                    <div class="cs-stack-label">Tech Stack</div>
                    <div class="cs-tech">Blazor WASM</div>
                    <div class="cs-tech">Azure CDN</div>
                    <div class="cs-tech">GitHub Actions</div>
                    <div class="cs-tech">Flat-file JSON</div>
                </div>
            </div>
            <div class="cs-content">
                <h3 class="cs-title">Zero-Cost, Sub-Second Portfolio Platform for International Market Entry</h3>
                <div class="cs-sections">
                    <div>
                        <div class="cs-section-label">Challenge</div>
                        <p class="cs-section-text">Establishing credibility for a new specialized consultancy without venture capital — requiring a platform that itself demonstrates the technical expertise being sold to international clients.</p>
                    </div>
                    <div>
                        <div class="cs-section-label">Approach</div>
                        <p class="cs-section-text">Architected a fully prerendered Blazor WASM application on Azure Static Web Apps Free Tier — zero operating cost, globally distributed via CDN, sub-second FCP, flat-file JSON data strategy, no database.</p>
                    </div>
                    <div>
                        <div class="cs-section-label">Outcome</div>
                        <div class="cs-outcome-num">$0<span>/mo</span></div>
                        <p class="cs-section-text">&lt;1s FCP globally. The platform itself became the proof of expertise — a living technical resume demonstrating the exact capabilities being sold.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="work-cta">
        <div class="container">
            <div class="cta-row">
                <p class="cta-quote reveal">Have a project that needs this level of precision?</p>
                <div class="reveal reveal-d1">
                    <a href="/contact" class="btn-primary">
                        <span>Start a conversation</span><span class="arrow-right">→</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("GSTApp.initReveal");
    }
}
