@page "/process"
@inject IJSRuntime JS

<div class="page-header">
    <div class="container">
        <div class="ph-eyebrow"><div class="ph-eyebrow-line"></div><span>The Method</span></div>
        <h1 class="ph-title">
            <span class="line"><span>Our</span></span>
            <span class="line"><span class="accent">Process.</span></span>
        </h1>
        <p class="ph-sub">Every engagement follows a proven architecture. No surprises. No scope creep. No ambiguity. You always know what's being built, why, and when it's delivered.</p>
    </div>
</div>

<!-- ── FOUR STEPS ─────────────────────────────────────────── -->
<section class="process-hero">
    <div class="process-bg-text">HOW</div>
    <div class="container">
        <div class="section-label">
            <div class="section-label-line"></div>
            <span>The Four Steps</span>
        </div>
        <div class="process-grid">
            <div class="reveal">
                <h2 class="process-title">Four steps.<br />Zero<br />surprises.</h2>
                <p class="process-intro">Our process is designed to protect your budget, your timeline, and your sanity. Every decision is documented and approved before it becomes code.</p>
            </div>
            <div class="steps">
                <div class="step reveal">
                    <div class="step-num">01</div>
                    <div class="step-body">
                        <h4>Discovery &amp; Problem Definition</h4>
                        <p>We begin with the business problem, not the technology. A thorough audit of your current system, pain points, and measurable goals establishes the engagement scope before any code is written.</p>
                    </div>
                </div>
                <div class="step reveal reveal-d1">
                    <div class="step-num">02</div>
                    <div class="step-body">
                        <h4>Architecture &amp; Design</h4>
                        <p>We produce a Software Design Document before writing a single line of code. Stack decisions, data models, directory structure, and cost analysis are all approved upfront by you.</p>
                    </div>
                </div>
                <div class="step reveal reveal-d2">
                    <div class="step-num">03</div>
                    <div class="step-body">
                        <h4>Delivery in Milestones</h4>
                        <p>Four-week sprints with clear deliverables. Foundation, Core UI, Performance optimization, and Launch. Each milestone is a production-deployable checkpoint — not a demo.</p>
                    </div>
                </div>
                <div class="step reveal reveal-d3">
                    <div class="step-num">04</div>
                    <div class="step-body">
                        <h4>Outcome Verification</h4>
                        <p>We measure what we promised. Every engagement closes with quantified outcomes against the goals defined in Discovery — the data you need to justify the ROI internally.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ── 4-WEEK SPRINT TEMPLATE ─────────────────────────────── -->
<section class="sprint-section">
    <div class="container">
        <div class="section-label"><div class="section-label-line"></div><span>4-Week Sprint Template</span></div>
        <div class="phase-grid reveal">
            <div class="phase">
                <div class="phase-week">Week 01</div>
                <div class="phase-title">Foundation &amp; CSS</div>
                <div class="phase-items">
                    <div class="phase-item">Repository setup</div>
                    <div class="phase-item">dotnet new scaffolding</div>
                    <div class="phase-item">CSS Grid layout system</div>
                    <div class="phase-item">CSS custom properties</div>
                    <div class="phase-item">CI/CD pipeline configuration</div>
                </div>
            </div>
            <div class="phase">
                <div class="phase-week">Week 02</div>
                <div class="phase-title">Data &amp; Core UI</div>
                <div class="phase-items">
                    <div class="phase-item">portfolio.json schema</div>
                    <div class="phase-item">Domain entity models</div>
                    <div class="phase-item">Core component library</div>
                    <div class="phase-item">HTTP client service layer</div>
                    <div class="phase-item">Layout components</div>
                </div>
            </div>
            <div class="phase">
                <div class="phase-week">Week 03</div>
                <div class="phase-title">Speed &amp; Content</div>
                <div class="phase-items">
                    <div class="phase-item">Static Site Generation</div>
                    <div class="phase-item">Prerendering implementation</div>
                    <div class="phase-item">SEO metadata system</div>
                    <div class="phase-item">Mobile responsiveness</div>
                    <div class="phase-item">Content population</div>
                </div>
            </div>
            <div class="phase">
                <div class="phase-week">Week 04</div>
                <div class="phase-title">Launch</div>
                <div class="phase-items">
                    <div class="phase-item">Quality assurance</div>
                    <div class="phase-item">Lighthouse performance audit</div>
                    <div class="phase-item">Custom domain configuration</div>
                    <div class="phase-item">Azure Static Web Apps deploy</div>
                    <div class="phase-item">Outcome measurement</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ── FEASIBILITY ────────────────────────────────────────── -->
<section class="feasibility-section">
    <div class="container">
        <div class="section-label"><div class="section-label-line"></div><span>Feasibility Standards</span></div>
        <div class="feasibility-grid">
            <div class="feas-item reveal">
                <div class="feas-label">Technical Feasibility</div>
                <div class="feas-rating">High</div>
                <div class="feas-text">100% .NET/C# stack alignment with the Lead Developer's expertise. The contradiction between Blazor WASM load times and static hosting is resolved via Prerendering, ensuring instant First Contentful Paint.</div>
            </div>
            <div class="feas-item reveal reveal-d1">
                <div class="feas-label">Economic Feasibility</div>
                <div class="feas-rating">Superior</div>
                <div class="feas-text">Hosting: $0.00. Database: $0.00. Maintenance: $0.00. No OS patching or DB backups required. Every project is Default Alive with zero burn rate from day one.</div>
            </div>
            <div class="feas-item reveal reveal-d2">
                <div class="feas-label">Operational Feasibility</div>
                <div class="feas-rating">Optimal</div>
                <div class="feas-text">Global CDN distribution ensures the site loads as fast in New York as it does in Nairobi. Updates handled via Git push. CI/CD automates deployment in under 2 minutes.</div>
            </div>
        </div>
    </div>
</section>

<!-- ── BOTTOM CTA ─────────────────────────────────────────── -->
<section class="process-cta">
    <div class="container">
        <div class="cta-row">
            <div class="reveal">
                <h3 class="cta-heading">Ready to start<br />the process?</h3>
            </div>
            <div class="reveal reveal-d1 cta-actions">
                <a href="/contact" class="btn-primary"><span>Start a project</span><span class="arrow-right">→</span></a>
                <a href="/work"    class="btn-secondary"><span>See the results</span><span class="arrow-right">→</span></a>
            </div>
        </div>
    </div>
</section>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("GSTApp.initReveal");
    }
}
