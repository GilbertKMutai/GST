@page "/process"
@inject IJSRuntime JS

<div class="page-header">
    <div class="container">
        <span class="eyebrow reveal"><span class="dot"></span>The method</span>
        <h1 class="page-title reveal reveal-d1">Our process.</h1>
        <p class="page-sub reveal reveal-d2">
            Every engagement follows the same architecture. No surprises, no scope creep - you
            always know what's being built, why, and when it ships.
        </p>
    </div>
</div>

<!-- ── FOUR STEPS ─────────────────────────────────────────── -->
<section class="section">
    <div class="container">
        <div class="grid-2">
            <div class="reveal">
                <span class="eyebrow-kicker">Four steps</span>
                <h2 class="display-2">Zero surprises, by design.</h2>
                <p class="lead" style="margin-top:16px;">The process protects your budget, your
                    timeline, and your sanity. Every decision is documented and approved before it
                    becomes code.</p>
            </div>
            <div class="steps reveal reveal-d1">
                <div class="step-row">
                    <span class="step-num">01</span>
                    <div>
                        <h4>Discovery &amp; problem definition</h4>
                        <p>We begin with the business problem, not the technology. An audit of your
                            current system, pain points, and measurable goals sets the scope before
                            any code is written.</p>
                    </div>
                </div>
                <div class="step-row">
                    <span class="step-num">02</span>
                    <div>
                        <h4>Architecture &amp; design</h4>
                        <p>We produce a design document before writing a single line of code. Stack
                            decisions, data models, and cost are approved upfront, by you.</p>
                    </div>
                </div>
                <div class="step-row">
                    <span class="step-num">03</span>
                    <div>
                        <h4>Delivery in milestones</h4>
                        <p>Four-week sprints with clear deliverables - foundation, core UI,
                            performance, and launch. Each milestone is a deployable checkpoint, not
                            a demo.</p>
                    </div>
                </div>
                <div class="step-row">
                    <span class="step-num">04</span>
                    <div>
                        <h4>Outcome verification</h4>
                        <p>We measure what we promised. Every engagement closes with quantified
                            outcomes against the goals defined in discovery.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ── 4-WEEK SPRINT TEMPLATE ─────────────────────────────── -->
<section class="section section-alt section-border-t">
    <div class="container">
        <span class="eyebrow-kicker reveal">A typical sprint</span>
        <h2 class="display-2 reveal" style="margin-bottom:40px;">The four-week template.</h2>
        <div class="grid-4 phase-grid reveal reveal-d1">
            <div class="card phase">
                <div class="phase-week">Week 01</div>
                <div class="phase-title">Foundation</div>
                <ul>
                    <li>Repository &amp; scaffolding</li>
                    <li>CSS design system</li>
                    <li>CI/CD pipeline</li>
                </ul>
            </div>
            <div class="card phase">
                <div class="phase-week">Week 02</div>
                <div class="phase-title">Data &amp; core UI</div>
                <ul>
                    <li>Domain entity models</li>
                    <li>Core component library</li>
                    <li>Service layer</li>
                </ul>
            </div>
            <div class="card phase">
                <div class="phase-week">Week 03</div>
                <div class="phase-title">Speed &amp; content</div>
                <ul>
                    <li>Prerendering</li>
                    <li>SEO metadata</li>
                    <li>Mobile responsiveness</li>
                </ul>
            </div>
            <div class="card phase">
                <div class="phase-week">Week 04</div>
                <div class="phase-title">Launch</div>
                <ul>
                    <li>QA &amp; performance audit</li>
                    <li>Domain &amp; deploy</li>
                    <li>Outcome measurement</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- ── WHY THE MODEL WORKS ────────────────────────────────── -->
<section class="section">
    <div class="container">
        <span class="eyebrow-kicker reveal">Why it holds up</span>
        <h2 class="display-2 reveal" style="margin-bottom:40px;">Built to be cheap to run and easy to trust.</h2>
        <div class="grid-3 feas-grid reveal reveal-d1">
            <div class="card">
                <div class="feas-rating">Technical</div>
                <p>Full .NET/C# stack alignment throughout. Blazor WASM load times are resolved
                    with prerendering, so pages feel instant even on static hosting.</p>
            </div>
            <div class="card">
                <div class="feas-rating">Economic</div>
                <p>Static hosting, database, and maintenance can run near $0 - no OS patching, no
                    manual backups, no idle server burn from day one.</p>
            </div>
            <div class="card">
                <div class="feas-rating">Operational</div>
                <p>Global CDN distribution means the site loads as fast in New York as it does in
                    Nairobi. Updates ship via a Git push, automated end to end.</p>
            </div>
        </div>
    </div>
</section>

<section class="section section-alt section-border-t process-cta">
    <div class="container cta-row">
        <h2 class="display-2 reveal">Ready to start the process?</h2>
        <div class="btn-row reveal reveal-d1">
            <a href="/contact" class="btn btn-primary">Start a project →</a>
            <a href="/work" class="btn btn-secondary">See the results</a>
        </div>
    </div>
</section>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("GSTApp.initReveal");
    }
}
