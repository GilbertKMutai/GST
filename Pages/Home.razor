@page "/"
@inject IJSRuntime JS

<!-- ── HERO ──────────────────────────────────────────────── -->
<section class="hero" id="hero">
    <div class="hero-bg-line"></div>
    <div class="hero-bg-line"></div>
    <div class="hero-bg-line"></div>
    <div class="hero-bg-line"></div>

    <figure class="hero-visual reveal reveal-d1">
        <img src="/images/gst-hero-engineering.webp"
        <figcaption>
            <span>Cloud-ready delivery</span>
            <strong>.NET systems designed for measurable operating gains.</strong>
        </figcaption>
    </figure>

    <div class="hero-content">
        <div class="hero-eyebrow">
            <div class="hero-eyebrow-line"></div>
            <span>Nairobi, Kenya · Serving Global Teams</span>
        </div>
        <h1 class="hero-title">
            <span class="hero-title-line"><span>Engineering</span></span>
            <span class="hero-title-line"><span class="accent-w">Digital</span></span>
            <span class="hero-title-line"><span>Authority.</span></span>
        </h1>
        <div class="hero-actions">
            <a href="/contact" class="btn-primary">
                <span>Start a project</span><span class="arrow-right">→</span>
            </a>
            <a href="/work" class="btn-secondary">
                <span>See proof</span><span class="arrow-right">→</span>
            </a>
        </div>
    </div>

    <div class="hero-bottom">
        <p class="hero-desc">
           We build high-performance Blazor, .NET, and cloud systems for companies that need reliable software, clean architecture, and measurable business outcomes.
           From legacy modernization to cloud-ready web applications, we help international teams move faster without compromising quality.
        </p>
        <div class="hero-stats">
            <div class="stat">
                <div class="stat-num">60<span class="u">%</span></div>
                <div class="stat-label">Reduction in administration time</div>
            </div>
            <div class="stat">
                <div class="stat-num">12K<span class="u">+</span></div>
                <div class="stat-label">Users supported across institutional platforms</div>
            </div>
            <div class="stat">
                <div class="stat-num">5<span class="u">+</span></div>
                <div class="stat-label">International organizations supported</div>
            </div>
        </div>
    </div>

    <div class="scroll-indicator">
        <div class="scroll-line"></div>
        <span>Scroll</span>
    </div>
</section>

