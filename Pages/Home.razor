</div>

<!-- ── CONTACT CTA ────────────────────────────────────────── -->
<section class="overview-section">
    <div class="container">
        <div class="ov-grid-2">
            <div class="reveal">
                <h2 class="ov-heading cta-heading">Let's<br />Build<br /><span class="accent-w">Together.</span></h2>
            </div>
            <div class="self-center">
                <p class="ov-text reveal reveal-d1">
                    Great software does more than function. It moves businesses forward, 
                    simplifies complex operations, and creates digital experiences people
                    trust. If you are building something important, we can help you bring 
                    it to life with clarity, precision, and engineering discipline.
                </p>
                <div class="ov-cta-row reveal reveal-d2">
                    <a href="/contact" class="btn-primary">
                        <span>Start a project</span><span class="arrow-right">→</span>
                    </a>
                    <a href="/work" class="btn-secondary">
                        <span>View our work</span><span class="arrow-right">→</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("GSTApp.initReveal");
    }
}
