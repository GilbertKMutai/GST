@page "/"
@inject IJSRuntime JS

<!-- ── HERO ──────────────────────────────────────────────── -->
<section class="hero" id="hero">
    <div class="hero-bg-line"></div>
    <div class="hero-bg-line"></div>
    <div class="hero-bg-line"></div>
    <div class="hero-bg-line"></div>

    <div class="hero-content">
        <div class="hero-eyebrow">
            <div class="hero-eyebrow-line"></div>
            <span>Nairobi, Kenya · Est. 2025</span>
        </div>
        <h1 class="hero-title">
            <span class="hero-title-line"><span>Engineering</span></span>
            <span class="hero-title-line"><span class="accent-w">Digital</span></span>
            <span class="hero-title-line"><span>Authority.</span></span>
        </h1>
    </div>

    <div class="hero-bottom">
        <p class="hero-desc">
            High-performance .NET &amp; Cloud Engineering for international markets.
            We transform digital liabilities into profitable assets — one architecture at a time.
        </p>
        <div class="hero-stats">
            <div class="stat">
                <div class="stat-num">60<span class="u">%</span></div>
                <div class="stat-label">Check-in time reduced</div>
            </div>
            <div class="stat">
                <div class="stat-num">100<span class="u">%</span></div>
                <div class="stat-label">WCAG 2.0 compliant</div>
            </div>
            <div class="stat">
                <div class="stat-num">&lt;1<span class="u">s</span></div>
                <div class="stat-label">First contentful paint</div>
            </div>
        </div>
    </div>

    <div class="scroll-indicator">
        <div class="scroll-line"></div>
        <span>Scroll</span>
    </div>
</section>

<!-- ── MARQUEE ───────────────────────────────────────────── -->
<div class="marquee-strip">
    <div class="marquee-track">
        <span class="marquee-item"><span class="marquee-dot"></span>Blazor WebAssembly</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Blazor Server</span>
