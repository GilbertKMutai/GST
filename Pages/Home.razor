<!-- ── CASE STUDIES OVERVIEW ─────────────────────────────── -->
<section class="overview-section">
    <div class="container">
        <div class="section-label">
            <div class="section-label-line"></div>
            <span>Selected Work</span>
        </div>
        <div class="ov-grid-2 mb-60 align-end">
            <div class="reveal"><h2 class="ov-heading">Case<br />Studies.</h2></div>
            <div class="reveal reveal-d1">
                <a href="/work" class="btn-secondary">
                    <span>View all work</span><span class="arrow-right">→</span>
                </a>
            </div>
        </div>
        <div class="case-preview">
            <div class="cp-item reveal">
                <div class="cp-image">
                    <img src="/images/case-library-portal.webp"
                         alt="Library portal interface mockup shown on tablet screens"
                         loading="lazy" />
                </div>
                <div class="cp-tag">Library Systems · Singapore</div>
                <div class="cp-num">01</div>
                <div class="cp-title">Rebuilding an Existing React Library Platform as a Customized Blazor Solution</div>
                <div class="cp-outcome-block">
                    <div class="cp-outcome">50<span>%</span></div>
                </div>
                <div class="cp-outcome-label"><strong>Reduction</strong> in maintenance effort &nbsp;·&nbsp; Customized workflows &nbsp;·&nbsp; Accessible user experience</div>
                <a href="/work" class="cp-more">Read case study</a>
            </div>
            <div class="cp-item reveal reveal-d1">
                <div class="cp-image">
                    <img src="/images/case-rental-checkin.webp"
                         alt="Rental check-in workflow software mockup on laptop and tablet"
                         loading="lazy" />
                </div>
                <div class="cp-tag">PropTech · Netherlands</div>
                <div class="cp-num">02</div>
                <div class="cp-title">Reducing Check-In Times by 60% via Custom .NET Architecture</div>
                <div class="cp-outcome">60<span>%</span></div>
                <div class="cp-outcome-label"><strong>Faster</strong> administration time &nbsp;·&nbsp; Digital check-ins &nbsp;·&nbsp; Document automation &nbsp;·&nbsp; Secure guest workflows</div>
                <a href="/work" class="cp-more">Read case study</a>
            </div>
        </div>
    </div>
</section>

<!-- ── PROCESS OVERVIEW ───────────────────────────────────── -->
<section class="overview-section alt-bg">
    <div class="container">
        <div class="section-label">
            <div class="section-label-line"></div>
            <span>The Method</span>
        </div>
        <div class="ov-grid-2 mb-60">
            <div class="reveal"><h2 class="ov-heading">Our<br />Process.</h2></div>
            <div class="reveal reveal-d1 self-end">
                <p class="ov-text">Every engagement follows a structured process designed to reduce risk, protect scope, and keep delivery aligned with business outcomes.</p>
                <div class="ov-cta-row">
                    <a href="/process" class="btn-secondary">
                        <span>See the full process</span><span class="arrow-right">→</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="pp-list reveal">
            <div class="pp-step">
                <div class="pp-num">01</div>
                <div class="pp-body"><h4>Discovery &amp; Problem Definition</h4>
                    <p>
                       We start by understanding the business problem, the users, the workflow, and the outcome the software is expected to create.
                       <br />
                       <br />
                       No assumptions. No premature technology decisions.
                    </p>
                </div>
                <div class="pp-arrow">→</div>
            </div>
            <div class="pp-step">
                <div class="pp-num">02</div>
                <div class="pp-body"><h4>Architecture &amp; Technical Planning</h4>
                    <p>
                        Before development begins, we define the system architecture, data flow, integrations, security requirements, and delivery milestones.
                        <br />
                        <br />
                        This gives every stakeholder clarity before code is written.
                    </p>
                </div>
                <div class="pp-arrow">→</div>
            </div>
            <div class="pp-step">
                <div class="pp-num">03</div>
                <div class="pp-body"><h4>Milestone-Based Delivery</h4>
                    <p>
                        Work is delivered in clear, reviewable milestones so progress is visible and feedback is captured early.
                        <br />
                        <br />
                        You see working software throughout the engagement, not just at the end.
                    </p>
                </div>
                <div class="pp-arrow">→</div>
            </div>
            <div class="pp-step">
                <div class="pp-num">04</div>
                <div class="pp-body"><h4>Testing, Deployment & Outcome Review</h4>
                    <p>
                        We validate the system against the goals defined during discovery, prepare it for 
                        production, and ensure it is stable, usable, and maintainable.
                    </p>
                </div>
                <div class="pp-arrow">→</div>
            </div>
        </div>
    </div>
</section>

