@page "/services"
@inject IJSRuntime JS

<div class="page-header">
    <div class="container">
        <div class="ph-eyebrow"><div class="ph-eyebrow-line"></div><span>Capabilities</span></div>
        <h1 class="ph-title">
            <span class="line"><span>What</span></span>
            <span class="line"><span class="accent">We Do.</span></span>
        </h1>
         <p class="ph-sub">
            We design, build, and modernize high-performance .NET, Blazor, and cloud systems for businesses that need software they can trust.
            No bloated teams. No vague handoffs. Just focused engineering, direct accountability, and systems built to perform from day one.
        </p>
    </div>
</div>

<section class="services-section">
    <div class="container">
        <div class="section-label">
            <div class="section-label-line"></div>
            <span>Core Services</span>
            <div class="section-label-num">7 Capabilities</div>
        </div>
        <div class="services-list">
            <div class="service-item reveal">
                <span class="svc-num">01</span>
                <div class="svc-icon">◈</div>
                <h3>Blazor Web Development</h3>
                <p>
                    Modern web applications built with the power of C# and the flexibility of Blazor.
                    We create fast, interactive, and maintainable user interfaces for businesses that want clean architecture,
                    reusable components, and a seamless full-stack .NET experience.
                </p>
                <p>
                    From internal dashboards to customer-facing platforms, we build Blazor applications that are structured for
                    performance, clarity, and long-term growth.
                </p>
                <div class="svc-tags">
                    <span class="tag">Blazor Server</span>
                    <span class="tag">Blazor WASM</span>
                    <span class="tag">Blazor Web App</span>
                    <span class="tag">Static SSR</span>
                    <span class="tag">Razor</span>
                    <span class="tag">C#</span>
                    <span class="tag">Prerendering</span>
                </div>
            </div>
            <div class="service-item reveal reveal-d1">
                <span class="svc-num">02</span>
                <div class="svc-icon">⬡</div>
                <h3>Azure Cloud Architecture</h3>
                 <p>
                    Cloud systems built for reliability, scale, and cost control.
                    We help businesses design and deploy Azure-powered applications that are secure, resilient, and ready for real-world usage.
                </p>
                <p>
                    Whether you need a lightweight web app, automated deployments, cloud storage, serverless workflows,
                    or production-grade infrastructure, we build with performance and maintainability in mind.
                </p>
                <div class="svc-tags">
                    <span class="tag">Azure</span>
                    <span class="tag">Azure Static Web Apps</span>
                    <span class="tag">Azure App Service</span>
                    <span class="tag">Azure Functions</span>
                    <span class="tag">Azure CDN</span>
                    <span class="tag">GitHub Actions</span>
                    <span class="tag">CI/CD</span>
                </div>
            </div>
            
            <div class="service-item reveal reveal-d2">
                <span class="svc-num">03</span>
                <div class="svc-icon">⬢</div>
                <h3>AWS Cloud Architecture</h3>
                <p>
                    Secure, scalable, and high-availability cloud infrastructure on AWS.
                    We design AWS environments that support modern web applications, backend systems, storage, databases,
                    and global content delivery.
                </p>
                <p>
                    From serverless workflows to production-ready hosting, we help businesses use AWS in a way that is practical,
                    cost-aware, and built for performance.
                </p>
                <div class="svc-tags">
                    <span class="tag">AWS</span>
                    <span class="tag">S3</span>
                    <span class="tag">EC2</span>
                    <span class="tag">RDS</span>
                    <span class="tag">Route 53</span>
                    <span class="tag">ACM</span>
                    <span class="tag">EBS</span>
                    <span class="tag">CodeBuild</span>
                    <span class="tag">CodePipeline</span>
                </div>
            </div>

            <div class="service-item reveal">
                <span class="svc-num">04</span>
                <div class="svc-icon">◎</div>
                <h3>Legacy System Migration</h3>
                <p>
                    Modernization without disruption.
                    We help businesses move from outdated desktop, web, or legacy .NET systems into modern Blazor and cloud-based platforms.
                </p>
                <p>
                    The goal is not just to replace old technology. The goal is to preserve what works, improve what slows you down,
                    and create a system that is easier to maintain, extend, and scale.
                </p>
                <div class="svc-tags">
                    <span class="tag">WPF to Blazor</span>
                    <span class="tag">Legacy .NET</span>
                    <span class="tag">Modern .NET</span>
                    <span class="tag">JavaScript to .NET</span>
                    <span class="tag">React to Blazor</span>
                    <span class="tag">Angular to Blazor</span>
                    <span class="tag">Vue.js to Blazor</span>
                    <span class="tag">Desktop to Web</span>
                    <span class="tag">Accessibility</span>
                </div>
            </div>
            <div class="service-item reveal reveal-d1">
                <span class="svc-num">05</span>
                <div class="svc-icon">⬟</div>
                <h3>Full-Stack .NET API Design</h3>
                <p>
                    Clean backend systems for serious business applications.
                    We design and build secure, maintainable APIs using ASP.NET Core, Entity Framework Core, SignalR,
                    and modern authentication standards.
                </p>
                <p>
                    Whether your application needs real-time communication, role-based access, integrations, reporting,
                    or complex business workflows, we create backend systems that are structured, reliable, and easy to extend.
                </p>
                <div class="svc-tags">
                              <span class="tag">ASP.NET Core</span>
                    <span class="tag">EF Core</span>
                    <span class="tag">Minimal APIs</span>
                    <span class="tag">SignalR</span>
                    <span class="tag">OAuth2</span>
                    <span class="tag">OpenID Connect</span>
                    <span class="tag">SQL Server</span>
                </div>
            </div>
            <div class="service-item reveal reveal-d2">
                <span class="svc-num">06</span>
                <div class="svc-icon">◇</div>
                <h3>Performance &amp; SEO Engineering</h3>
                <p>
                    Speed, visibility, and user experience built into the foundation.
                    We optimize applications for fast loading, strong Core Web Vitals, search visibility, and smooth user interaction.
                </p>
                <p>
                    From CDN delivery and caching strategies to metadata, structured content, and frontend performance,
                    we help your application feel faster and perform better across devices and networks.
                </p>
                <div class="svc-tags">
                    <span class="tag">Core Web Vitals</span>
                    <span class="tag">SEO</span>
                    <span class="tag">Lighthouse</span>
                    <span class="tag">CDN</span>
                    <span class="tag">Caching</span>
                    <span class="tag">Metadata</span>
                    <span class="tag">Load Speed</span>
                </div>
            </div>
            <div class="service-item reveal">
                <span class="svc-num">07</span>
                <div class="svc-icon">◉</div>
                <h3>Technical Consulting</h3>
                <p>
                    Specialized engineering support for teams that need clarity and execution.
                    We work with companies that need experienced .NET and cloud expertise without the overhead of a large agency.
                </p>
                <p>
                    Whether you need architecture guidance, project delivery, technical troubleshooting, system reviews,
                    or sprint-ready development capacity, we bring focused execution and clear communication to every engagement.
                </p>
                <div class="svc-tags">
                    <span class="tag">Technical Consulting</span>
                    <span class="tag">Architecture Reviews</span>
                    <span class="tag">Agile Delivery</span>
                    <span class="tag">Hourly Consulting</span>
                    <span class="tag">Project Planning</span>
                    <span class="tag">Milestones</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="stack-section">
    <div class="container">
        <div class="section-label"><div class="section-label-line"></div><span>Technology Stack</span></div>
        <div class="stack-grid">
            <div class="reveal">
                <h2 class="stack-heading">The Full<br />Stack.</h2>
                <p class="stack-intro">
                    Every technology we use is chosen with intention.
                    No unnecessary complexity. No trend-chasing. Just proven tools that support reliable, scalable, and maintainable software.
                </p>
            </div>
            <div class="tech-groups reveal reveal-d1">
                <div class="tech-group">
                    <div class="tg-label">Frontend</div>
                      <div class="tg-items">
                        <span class="tag">Blazor WASM</span>
                        <span class="tag">Blazor Server</span>
                        <span class="tag">Blazor Web App</span>
                        <span class="tag">Razor</span>
                        <span class="tag">HTML</span>
                        <span class="tag">CSS</span>
                        <span class="tag">Syncfusion</span>
                        <span class="tag">DevExpress</span>
                    </div>
                </div>
                <div class="tech-group">
                    <div class="tg-label">Backend</div>
                     <div class="tg-items">
                        <span class="tag">ASP.NET Core</span>
                        <span class="tag">EF Core</span>
                        <span class="tag">REST APIs</span>
                        <span class="tag">Minimal APIs</span>
                        <span class="tag">gRPC</span>
                        <span class="tag">SignalR</span>
                    </div>
                </div>
                <div class="tech-group">
                    <div class="tg-label">Cloud</div>
                    <div class="tg-items">
                        <span class="tag">Azure Static Web Apps</span>
                        <span class="tag">Azure App Service</span>
                        <span class="tag">Azure Functions</span>
                        <span class="tag">Azure CDN</span>
                        <span class="tag">AWS S3</span>
                        <span class="tag">AWS EC2</span>
                        <span class="tag">AWS CloudFront</span>
                        <span class="tag">AWS Route53</span>
                        <span class="tag">AWS IAM</span>
                        <span class="tag">AWS ACM</span>
                        <span class="tag">AWS Lambda</span>
                    </div>
                </div>
                <div class="tech-group">
                    <div class="tg-label">Auth &amp; Security</div>
                    <div class="tg-items">
                        <span class="tag">OAuth2</span>
                        <span class="tag">OpenID Connect</span>
                        <span class="tag">Role-Based Access</span>
                        <span class="tag">Biometric 2FA</span>
                        <span class="tag">Digital Signatures</span>
                    </div>
                </div>
                <div class="tech-group">
                    <div class="tg-label">DevOps</div>
                      <div class="tg-items">
                        <span class="tag">GitHub Actions</span>
                        <span class="tag">Azure DevOps</span>
                        <span class="tag">Docker</span>
                        <span class="tag">CI/CD Pipelines</span>
                    </div>
                </div>
                <div class="tech-group">
                    <div class="tg-label">Data</div>
                     <div class="tg-items">
                        <span class="tag">SQL Server</span>
                        <span class="tag">MySQL </span>
                        <span class="tag">PostgreSQL</span>
                        <span class="tag">JSON-Based Storage</span>
                        <span class="tag">Cloud Databases</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="services-cta">
    <div class="container">
        <div class="cta-row">
            <div class="reveal">
                <h3 class="cta-heading">Ready to build<br />something real?</h3>
                
                <p class="cta-text">
                    Bring the idea. Bring the challenge. We will help turn it into a stable, scalable, business-ready system.
                </p>
            </div>
            <div class="reveal reveal-d1 cta-actions">
                <a href="/contact" class="btn-primary"><span>Start a project</span><span class="arrow-right">→</span></a>
                <a href="/work"    class="btn-secondary"><span>See our work</span><span class="arrow-right">→</span></a>
            </div>
        </div>
    </div>
</section>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("GSTApp.initReveal");
    }
}
