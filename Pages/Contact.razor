@page "/contact"
@inject IJSRuntime JS

<div class="page-header">
    <div class="container">
        <span class="eyebrow reveal"><span class="dot"></span>Let's build</span>
        <h1 class="page-title reveal reveal-d1">Get in touch.</h1>
        <p class="page-sub reveal reveal-d2">
            Available for high-value freelance and company-to-company projects. Based in Nairobi,
            working with global teams. Response within 24 hours.
        </p>
    </div>
</div>

<section class="section">
    <div class="container grid-2 contact-grid">

        <!-- ── Left: Details ────────────────────────── -->
        <div class="reveal">
            <h2 class="display-2">Let's work together.</h2>
            <p class="lead" style="margin:18px 0 32px;">
                Whether you need a full-stack .NET application, Azure or AWS architecture, a
                legacy migration, or an embedded consultant — let's start with a conversation.
            </p>
            <div class="contact-info">
                <div class="ci-item">
                    <span>Email</span>
                    <a href="mailto:hello@buildwithgilbert.com">hello@buildwithgilbert.com</a>
                </div>
                <div class="ci-item">
                    <span>Location</span>
                    <strong>Nairobi, Kenya · UTC+3</strong>
                </div>
                <div class="ci-item">
                    <span>Availability</span>
                    <strong>Open to projects · Freelance · Company-to-company</strong>
                </div>
                <div class="ci-item">
                    <span>Entity type</span>
                    <strong>Registered as Gilbert Specialists Tech · Kenya</strong>
                </div>
                <div class="ci-item">
                    <span>Response time</span>
                    <strong>Within 24 hours · All time zones</strong>
                </div>
            </div>
        </div>

        <!-- ── Right: Form ──────────────────────────── -->
        <div class="reveal reveal-d1">
            <EditForm Model="_model" OnValidSubmit="HandleSubmit" class="contact-form">
                <DataAnnotationsValidator />

                <div class="form-field">
                    <label for="fname">Full name</label>
                    <InputText id="fname" @bind-Value="_model.Name" placeholder="Jane Doe" />
                </div>

                <div class="form-field">
                    <label for="fcompany">Company / organization</label>
                    <InputText id="fcompany" @bind-Value="_model.Company" placeholder="Optional" />
                </div>

                <div class="form-field">
                    <label for="femail">Email address</label>
                    <InputText id="femail" @bind-Value="_model.Email" type="email" placeholder="jane@company.com" />
                </div>

                <div class="form-field">
                    <label for="fbudget">Budget range</label>
                    <InputText id="fbudget" @bind-Value="_model.Budget" placeholder="Optional" />
                </div>

                <div class="form-field">
                    <label for="fmessage">Tell me about your project</label>
                    <InputTextArea id="fmessage" @bind-Value="_model.Message" placeholder="What are you building, and what's the timeline?" />
                </div>

                <button type="submit" class="btn btn-primary submit-btn" disabled="@_sending">
                    @(_sending ? "Sending →" : "Send message →")
                </button>

                @if (_sent)
                {
                    <div class="form-success">✓ Message sent — I'll be in touch within 24 hours.</div>
                }
            </EditForm>
        </div>

    </div>
</section>

@code {
    private ContactModel _model  = new();
    private bool         _sending = false;
    private bool         _sent    = false;

    private async Task HandleSubmit()
    {
        _sending = true;
        // Replace with your actual Formspree endpoint or API call
        await Task.Delay(1200);
        _sending = false;
        _sent    = true;
        _model   = new ContactModel();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("GSTApp.initReveal");
    }

    private class ContactModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Name    { get; set; } = "";
        public string Company { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email   { get; set; } = "";

        public string Budget  { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string Message { get; set; } = "";
    }
}
