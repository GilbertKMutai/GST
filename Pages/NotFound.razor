@page "/not-found"
@layout MainLayout

<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:70vh;gap:20px;padding:48px 24px;text-align:center;">
    <span style="font-size:0.85rem;font-weight:700;color:var(--accent);">404</span>
    <h1 style="font-size:clamp(32px,6vw,52px);font-weight:800;letter-spacing:-0.02em;color:var(--ink);max-width:480px;">
        This page doesn't exist.
    </h1>
    <p style="font-size:1rem;color:var(--ink-dim);max-width:380px;line-height:1.7;">
        Even the best-planned systems have edge cases. This is one of them — let's get you back
        on track.
    </p>
    <a href="/" class="btn btn-primary" style="margin-top:8px;">← Back to home</a>
</div>
