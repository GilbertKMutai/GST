@page "/not-found"
@layout MainLayout

<h3>404 — Page Not Found</h3>

<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:60vh;gap:32px;padding:48px;text-align:center;">
    <h1 style="font-family:'Bebas Neue',cursive;font-size:clamp(80px,12vw,180px);line-height:1;color:#FF4D00;letter-spacing:.02em;">404</h1>
    <p style="font-size:1rem;color:var(--text-dim);max-width:380px;line-height:1.75;">This page doesn't exist. Let's get you back on track.</p>
    <a href="/" style="font-family:'DM Mono',monospace;font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:#fff;background:#FF4D00;padding:18px 40px;text-decoration:none;">←Back to Home</a>
</div>