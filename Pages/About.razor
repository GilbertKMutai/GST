@page "/about"
@inject IJSRuntime JS

<div class="page-header">
    <div class="container">
        <span class="eyebrow reveal"><span class="dot"></span>The Consultancy</span>
        <h1 class="page-title reveal reveal-d1">About Gilbert Specialists Tech.</h1>
        <p class="page-sub reveal reveal-d2">
            A focused .NET, Blazor, and cloud engineering consultancy helping ambitious businesses
            build faster, more reliable digital systems. Based in Nairobi. Built for global teams.
        </p>
    </div>
</div>

<!-- ── PHILOSOPHY ────────────────────────────────────────── -->
<section class="section">
    <div class="container">
        <div class="grid-2">
            <div class="reveal">
                <span class="eyebrow-kicker">Our philosophy</span>
                <h2 class="display-2">We build software that moves the business forward.</h2>
            </div>
            <div class="reveal reveal-d1">
                <p class="prose-p">
                    Gilbert Specialists Tech is a boutique engineering consultancy specializing in
                    .NET, Blazor, cloud architecture, and AI-enabled business systems. We help
                    companies modernize critical applications, improve operational efficiency, and
                    turn underperforming software into a reliable business asset.
                </p>
                <p class="prose-p">
                    We work with teams that need more than development capacity - they need
                    technical judgment, clean execution, and systems built with long-term value in
                    mind. Based in Nairobi and available globally, we're structured for remote
                    collaboration with companies across the US, Europe, and beyond.
                </p>
            </div>
        </div>

        <div class="grid-3 pillars reveal reveal-d2">
            <div class="card">
                <div class="pillar-num">01</div>
                <h3 class="display-3">Business before code</h3>
                <p>We don't build features to close tickets. We build systems that reduce friction,
                    support growth, and create measurable value — the code is just how we get there.</p>
            </div>
            <div class="card">
                <div class="pillar-num">02</div>
                <h3 class="display-3">Reliability by design</h3>
                <p>Critical software should be dependable and easy to maintain. We design for
                    performance, security, and stability from the first commit, not the last one.</p>
            </div>
            <div class="card">
                <div class="pillar-num">03</div>
                <h3 class="display-3">Modernize without chaos</h3>
                <p>Whether it's legacy code, a Blazor migration, or a move to the cloud, we
                    modernize without disrupting the business that depends on the system staying up.</p>
            </div>
        </div>
    </div>
</section>

<!-- ── WHY / HOW / WHAT ──────────────────────────────────── -->
<section class="section section-alt section-border-t">
    <div class="container">
        <div class="grid-3 gc-grid">
            <div class="reveal">
                <span class="eyebrow-kicker">Why</span>
                <p class="gc-text">Because software should do more than function. It should make
                    the business faster, clearer, and more resilient than it was before.</p>
            </div>
            <div class="reveal reveal-d1">
                <span class="eyebrow-kicker">How</span>
                <p class="gc-text">Through focused engineering, modern .NET architecture, and a
                    practical understanding of how real businesses actually operate.</p>
            </div>
            <div class="reveal reveal-d2">
                <span class="eyebrow-kicker">What</span>
                <p class="gc-text">Web applications, business platforms, cloud systems, and
                    AI-enabled software for teams that need dependable execution.</p>
            </div>
        </div>
    </div>
</section>

<!-- ── FOUNDER ────────────────────────────────────────────── -->
<section class="section">
    <div class="container grid-2 founder-block">
        <div class="reveal">
            <img src="/images/gilbert-mutai.webp" alt="Gilbert Mutai, founder of Gilbert Specialists Tech" class="founder-photo" />
            <h2 class="display-2">Gilbert Mutai.</h2>
            <p class="prose-p">
                Founder and Lead Engineer of Gilbert Specialists Tech. A full-stack .NET specialist
                with a singular focus on reliability, conversion, and modern cloud engineering.
            </p>
            <p class="prose-p">
                His work sits at the intersection of clean software architecture, cloud engineering,
                and honest business execution - turning technical ideas into stable, usable systems
                without over-promising along the way.
            </p>
        </div>
        <div class="reveal reveal-d1 founder-detail">
            <div class="fd-item"><span>Specialization</span><strong>.NET · C# · Blazor · Azure · AWS · AI</strong></div>
            <div class="fd-item"><span>Entity</span><strong>Gilbert Specialists Tech · Kenya</strong></div>
            <div class="fd-item"><span>Business structure</span><strong>Professional independent consultancy</strong></div>
            <div class="fd-item"><span>Availability</span><strong>Open to selected projects and contracts</strong></div>
            <div class="fd-item"><span>Location</span><strong>Nairobi, Kenya · UTC+3</strong></div>
            <div class="btn-row" style="margin-top:28px;">
                <a href="/contact" class="btn btn-primary">Work with GST →</a>
            </div>
        </div>
    </div>
</section>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("GSTApp.initReveal");
    }
}
