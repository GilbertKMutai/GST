@page "/about"
@inject IJSRuntime JS

<div class="page-header">
    <div class="container">
        <div class="ph-eyebrow">
            <div class="ph-eyebrow-line"></div>
            <span>The Agency</span>
        </div>
        <h1 class="ph-title">
            <span class="line"><span>About</span></span>
            <span class="line"><span class="accent">G S Tech.</span></span>
        </h1>
        <p class="ph-sub">
            A focused .NET, Blazor, and cloud engineering consultancy helping 
            ambitious businesses build faster, smarter, and more reliable 
            digital systems.
            <br/>
            <br/>
            Based in Nairobi. Built for global teams.
        </p>
    </div>
</div>

<!-- ── PHILOSOPHY ────────────────────────────────────────── -->
<section class="about-section">
    <div class="container">
        <div class="section-label">
            <div class="section-label-line"></div>
            <span>Our Philosophy</span>
        </div>
        <div class="about-grid">
            <div class="reveal">
                <h2 class="about-heading">
                    We build software<br />
                    that moves the <em>business</em><br />
                    forward.
                </h2>
            </div>
            <div>
                <p class="about-text reveal">
                    Gilbert Specialists Tech is a boutique software engineering consultancy specializing in .NET, Blazor, cloud architecture, and AI-enabled business systems.
                    We help companies modernize critical applications, improve operational efficiency, and turn underperforming software into reliable business assets.
                </p>
                <p class="about-text reveal reveal-d1">
                    We work with teams that need more than development capacity. They need technical judgment, clean execution, and systems built with long-term business value in mind.
                    From modern web platforms to cloud-backed internal systems, every engagement is shaped around clarity, reliability, and measurable impact.
                </p>
                <p class="about-text reveal reveal-d2">
                    Based in Nairobi and available globally, we are structured for remote collaboration with companies across the USA, Europe, and international markets.
                    Our approach combines engineering depth with the professionalism required for serious cross-border work.
                </p>

                <div class="about-pillars">
                    <div class="pillar reveal reveal-d1">
                        <div class="pillar-num">01</div>
                        <div class="pillar-body">
                            <h4>Business Before Code</h4>
                             <p>
                                We do not build features just to complete tickets. We build systems that reduce friction, improve workflows, support growth, and create measurable business value.
                            </p>
                        </div>
                    </div>
                    <div class="pillar reveal reveal-d2">
                        <div class="pillar-num">02</div>
                        <div class="pillar-body">
                            <h4>Reliability by Design</h4>
                            <p>
                                Critical software should be dependable, scalable, and easy to maintain. We design with performance, security, and long-term stability from the beginning.
                            </p>
                        </div>
                    </div>
                    <div class="pillar reveal reveal-d3">
                        <div class="pillar-num">03</div>
                        <div class="pillar-body">
                            <h4>Modernization Without Chaos</h4>
                            <p>
                                Whether improving legacy systems, migrating to Blazor, or moving workloads to the cloud, we help teams modernize without disrupting the business.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Golden Circle -->
        <div class="golden-circle reveal">
            <div class="gc-item">
                <div class="gc-label">Why</div>
                <div class="gc-text">
                    Because software should do more than function. It should make the business faster, clearer, more reliable, and more profitable.
                </div>
            </div>
            <div class="gc-item">
                <div class="gc-label">How</div>
                <div class="gc-text">
                    Through focused engineering, modern .NET architecture, cloud-ready systems, and a practical understanding of how real businesses operate.
                </div>
            </div>
            <div class="gc-item">
                <div class="gc-label">What</div>
                <div class="gc-text">
                    We build web applications, business platforms, cloud systems, and AI-enabled software for teams that need dependable execution.
                </div>
            </div>
        </div>

        <!-- Founder block -->
        <div class="founder-block">
            <div class="reveal">
                <h2 class="founder-title">Gilbert<br />Mutai.</h2>
                <p class="about-text">
                    Founder and Lead Engineer of Gilbert Specialists Tech. A full-stack .NET specialist
                    with a singular focus on conversion, reliability, and modern cloud engineering.
                </p>
                <p class="about-text">
                    His work sits at the intersection of clean software architecture, cloud engineering, and business execution - helping teams turn technical ideas into stable, usable, and valuable systems.
                </p>
            </div>
            <div class="founder-detail reveal reveal-d1">
                <div class="fd-item">
                    <span class="fd-label">Specialization</span>
                    <span class="fd-value">.NET · C# · Blazor · Azure · AWS · AI  </span>
                </div>
                <div class="fd-item">
                    <span class="fd-label">Entity</span>
                    <span class="fd-value">Gilbert Specialists Tech · Kenya</span>
                </div>
                <div class="fd-item">
                    <span class="fd-label">Business Structure</span>
                    <span class="fd-value">Professional independent consultancy</span>
                </div>
                <div class="fd-item">
                    <span class="fd-label">Availability</span>
                    <span class="fd-value">Available for selected projects and contracts</span>
                </div>
                <div class="fd-item">
                    <span class="fd-label">Location</span>
                    <span class="fd-value">Nairobi, Kenya · UTC+3</span>
                </div>
                <div class="cta-wrap">
                    <a href="/contact" class="btn-primary">
                        <span>Work with GST</span><span class="arrow-right">→</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("GSTApp.initReveal");
    }
}
