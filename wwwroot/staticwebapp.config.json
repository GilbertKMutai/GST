{
  "routes": [
    {"route": "/index.html", "headers": {"Cache-Control": "no-cache, no-store, must-revalidate"}},
    {"route": "/service-worker-assets.js", "headers": {"Cache-Control": "no-cache, no-store, must-revalidate"}},
    {"route": "/_framework/*.json", "headers": {"Cache-Control": "no-cache, must-revalidate"}},
    {"route": "/_framework/*.{wasm,js}", "headers": {"Cache-Control": "public, max-age=31536000, immutable"}},
    {"route": "/css/*.{css}", "headers": {"Cache-Control": "public, max-age=604800"}},
    {"route": "/*.{png,jpg,jpeg,gif,svg,webp,ico}", "headers": {"Cache-Control": "public, max-age=604800"}}
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{css,js,png,jpg,jpeg,gif,svg,webp,ico,json,wasm,dll,webmanifest}"]
  },
  "globalHeaders": {"X-Content-Type-Options": "nosniff"}
}
